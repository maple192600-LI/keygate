{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snail:licensing:request:v2",
  "title": "蜗牛授权申请 v2",
  "description": "开发合同，依据主规格第 7.2 节。解析前限制 64 KiB、深度 8、严格 UTF-8，并拒绝重复键。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "requestId",
    "productId",
    "device",
    "deviceLabel",
    "appVersion"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "description": "必须与客户端受保护发行策略的 productId 完全一致；蜗牛财务为 cn.snailfinance.desktop。"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "digest"
      ],
      "properties": {
        "type": {
          "const": "windows-machineguid-sha256/v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deviceLabel": {
      "type": "string",
      "maxLength": 80
    },
    "appVersion": {
      "type": "string",
      "maxLength": 40
    }
  }
}
