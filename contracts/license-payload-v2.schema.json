{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snail:licensing:license-payload:v2",
  "title": "蜗牛许可证签名载荷 v2",
  "description": "开发合同，依据主规格第 7.3 节。properties 顺序为签发端固定序列化顺序；JSON Schema 本身不强制键顺序。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "licenseId",
    "issuanceId",
    "productId",
    "purpose",
    "customerId",
    "revision",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "binding",
    "keyId"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "licenseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "issuanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "description": "必须与客户端受保护发行策略的 productId 完全一致；蜗牛财务为 cn.snailfinance.desktop。"
    },
    "purpose": {
      "const": "commercial"
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "固定毫秒 UTC 格式。实现仍须检查真实日历日期及规范化往返，不能只依赖正则。"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "固定毫秒 UTC 格式。实现仍须检查真实日历日期及规范化往返，不能只依赖正则。"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
          "description": "固定毫秒 UTC 格式。实现仍须检查真实日历日期及规范化往返，不能只依赖正则。"
        },
        {
          "type": "null"
        }
      ],
      "description": "null 代表永久；有限截止必须严格晚于 notBefore，到该时刻即失效。"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "digest"
      ],
      "properties": {
        "type": {
          "const": "windows-machineguid-sha256/v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "keyId": {
      "type": "string",
      "pattern": "^lic-[0-9a-f]{64}$"
    }
  }
}
